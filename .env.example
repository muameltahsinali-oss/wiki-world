# Docker Compose — copy to .env at repository root

APP_PORT=8080
FRONTEND_PORT=3000
DB_DATABASE=wikiworld
DB_USERNAME=wikiworld
DB_PASSWORD=wikiworld
DB_PORT=5432
REDIS_PORT=6379
