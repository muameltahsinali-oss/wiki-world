AI_RATE_LIMIT_GUEST=10
AI_RATE_LIMIT_REGISTERED=50
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
AWS_ACCESS_KEY_ID=wikiworld
AWS_SECRET_ACCESS_KEY=wikiworld_secret
