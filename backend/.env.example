APP_NAME="Wiki World"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wikiworld
DB_USERNAME=wikiworld
DB_PASSWORD=wikiworld

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@wikiworld.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=wikiworld
AWS_SECRET_ACCESS_KEY=wikiworld_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=wikiworld
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=
MEDIA_CDN_URL=

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=wikiworld_dev_key

SEARCH_ENABLED=true
SEARCH_DRIVER=database

AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_RATE_LIMIT_GUEST=10
AI_RATE_LIMIT_REGISTERED=50

FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=dev-revalidate-secret
